{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://d3-video/schemas/story-plan.schema.json",
  "title": "AI story and timed shot plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "duration_seconds", "premise", "audience_promise", "visual_motifs", "emotional_arc", "continuity_rules", "ending_image", "beats", "shots"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "premise": { "type": "string", "minLength": 1 },
    "audience_promise": { "type": "string", "minLength": 1 },
    "visual_motifs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "emotional_arc": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2 },
    "continuity_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "ending_image": { "type": "string", "minLength": 1 },
    "beats": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "purpose", "start_seconds", "end_seconds", "narration_segment_ids", "visual_concept", "character_direction"],
        "properties": {
          "id": { "type": "string", "pattern": "^beat_[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "narration_segment_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "visual_concept": { "type": "string", "minLength": 1 },
          "character_direction": { "type": "string", "minLength": 1 }
        }
      }
    },
    "shots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "beat_id", "start_seconds", "end_seconds", "narration_segment_ids", "story_beat", "environment", "characters", "props", "camera", "lighting", "composition", "transition_in", "transition_out", "continuity_notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^shot_[0-9]{3,}$" },
          "beat_id": { "type": "string", "pattern": "^beat_[0-9]{3,}$" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "narration_segment_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "story_beat": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "characters": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["asset", "action", "expression"],
              "properties": {
                "asset": { "type": "string" },
                "action": { "type": "string" },
                "expression": { "type": "string" },
                "animation": { "type": "string" },
                "position": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                "rotation_z": { "type": "number" }
              }
            }
          },
          "props": { "type": "array", "items": { "type": "string" } },
          "camera": {
            "type": "object", "additionalProperties": false,
            "required": ["type", "movement"],
            "properties": {
              "type": { "enum": ["wide", "medium", "close_up", "extreme_close_up", "over_shoulder", "top_down"] },
              "movement": { "enum": ["static", "pan", "tilt", "tracking", "dolly_in", "dolly_out", "orbit"] },
              "focal_length_mm": { "type": "number", "exclusiveMinimum": 0 },
              "angle": { "type": "string" }
            }
          },
          "lighting": { "type": "string", "minLength": 1 },
          "composition": {
            "type": "object", "additionalProperties": false,
            "required": ["foreground", "midground", "background"],
            "properties": {
              "foreground": { "type": "string" },
              "midground": { "type": "string" },
              "background": { "type": "string" }
            }
          },
          "transition_in": { "type": "string" },
          "transition_out": { "type": "string" },
          "continuity_notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
